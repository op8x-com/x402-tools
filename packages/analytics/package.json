{
  "name": "@op8x/analytics",
  "version": "0.0.3",
  "description": "Fail-open request analytics for x402 sellers: records 402 challenges, payments and receipts as metadata.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://docs.op8x.com",
  "bugs": "https://github.com/op8x-com/x402-tools/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/op8x-com/x402-tools.git",
    "directory": "packages/analytics"
  },
  "keywords": [
    "x402",
    "http-402",
    "payments",
    "analytics",
    "hono",
    "cloudflare-workers",
    "agents"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "hono": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "hono": "^4.13.0",
    "typescript": "5.9.3"
  }
}
