{
  "name": "@op8x/cli",
  "version": "0.0.3",
  "description": "Check an x402 endpoint from the outside: can real clients read its 402 challenge?",
  "license": "MIT",
  "type": "module",
  "bin": {
    "op8x": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://op8x.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/op8x-com/x402-tools.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "x402",
    "http-402",
    "payments",
    "cli",
    "agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@x402/core": "~2.29.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "5.9.3"
  }
}
