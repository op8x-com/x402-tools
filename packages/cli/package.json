{
  "name": "@op8x/cli",
  "version": "0.1.0",
  "description": "Checks x402 endpoints from the outside and connects them to op8x analytics.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "op8x": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://docs.op8x.com",
  "bugs": "https://github.com/op8x-com/x402-tools/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/op8x-com/x402-tools.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "x402",
    "http-402",
    "payments",
    "cli",
    "agents"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@x402/core": "~2.29.0"
  },
  "devDependencies": {
    "@solana/kit": "~8.6.0",
    "@types/node": "^24",
    "@x402/evm": "~2.29.0",
    "@x402/svm": "~2.29.0",
    "typescript": "5.9.3"
  }
}
